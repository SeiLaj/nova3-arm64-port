#include <jni.h>
#include <android/log.h>
#include <cstdio>
#include <cstring>

#define LOG_TAG "NOVA3_engine"
#define __android_log_print(ANDROID_LOG_ERROR, "NOVA3_engine", ...) __android_log_print(ANDROID_LOG_ERROR, LOG_TAG, __VA_ARGS__)

// Incluir o motor
#include "engine/glf_app.h"

extern "C" JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM* vm, void*) {
    __android_log_print(ANDROID_LOG_ERROR, "NOVA3_engine", "=== JNI_OnLoad CHAMADO ===");
    __android_log_print(ANDROID_LOG_ERROR, "NOVA3_engine", "JNI_OnLoad — clean stub");
    return JNI_VERSION_1_6;
}

extern "C" JNIEXPORT void JNICALL
Java_com_gameloft_android_ANMP_GloftN3HM_GL2JNILib_init(JNIEnv*, jclass) {
    __android_log_print(ANDROID_LOG_ERROR, "NOVA3_engine", "=== INIT JNI CHAMADO (ERROR) ===");
    __android_log_print(ANDROID_LOG_ERROR, "NOVA3_engine", "=== INIT JNI CHAMADO ===");
    __android_log_print(ANDROID_LOG_ERROR, "NOVA3_engine", "=== INIT CHAMADO ===");
    __android_log_print(ANDROID_LOG_ERROR, "NOVA3_engine", "init() -> glf::App");
    static glf::App s_app;
    glf::CreationSettings settings;
    settings.width = 1280;
    settings.height = 720;
    settings.flags = 0;
    s_app.Init(settings);
    s_app.MyInit();
    s_app.Run();
    glf::App::SetInstance(&s_app);
}

extern "C" JNIEXPORT void JNICALL
Java_com_gameloft_android_ANMP_GloftN3HM_GL2JNILib_step(JNIEnv*, jclass) {
    glf::App* app = glf::App::GetInstance();
    if (app) app->Update();
}

// Stubs para todas as outras funções JNI
#define STUB(name) \
extern "C" JNIEXPORT void JNICALL \
Java_com_gameloft_android_ANMP_GloftN3HM_GL2JNILib_##name(JNIEnv*, jclass) { __android_log_print(ANDROID_LOG_ERROR, "NOVA3_engine", #name); }

STUB(initGL)
STUB(resize)
STUB(setPaths)
STUB(nativeSetIsMOGA)
STUB(setResourcePath)

