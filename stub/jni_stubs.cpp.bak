#include <jni.h>
#include <android/log.h>
#include <cstdio>
#include <cstring>

#define LOG_TAG "NOVA3_stub"
#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, LOG_TAG, __VA_ARGS__)

static char g_path0[512], g_path1[512], g_path2[512], g_path3[512];

static void jstr_copy(JNIEnv* env, jstring js, char* dst, size_t n) {
    if (!dst || n == 0) return;
    dst[0] = '\0';
    if (!js) return;
    const char* s = env->GetStringUTFChars(js, nullptr);
    if (!s) return;
    strncpy(dst, s, n - 1);
    dst[n - 1] = '\0';
    env->ReleaseStringUTFChars(js, s);
}

extern "C" JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM*, void*) {
    LOGI("JNI_OnLoad — setPaths stub");
    return JNI_VERSION_1_6;
}

extern "C" JNIEXPORT void JNICALL
Java_com_gameloft_android_ANMP_GloftN3HM_GL2JNILib_setPaths(
    JNIEnv* env, jclass, jstring a, jstring b, jstring c, jstring d) {
    jstr_copy(env, a, g_path0, sizeof g_path0);
    jstr_copy(env, b, g_path1, sizeof g_path1);
    jstr_copy(env, c, g_path2, sizeof g_path2);
    jstr_copy(env, d, g_path3, sizeof g_path3);
    LOGI("setPaths[0]=%s", g_path0);
    LOGI("setPaths[1]=%s", g_path1);
    LOGI("setPaths[2]=%s", g_path2);
    LOGI("setPaths[3]=%s", g_path3);
}

extern "C" JNIEXPORT void JNICALL
Java_com_gameloft_android_ANMP_GloftN3HM_GL2JNILib_nativeSetIsMOGA(JNIEnv*, jclass, jint v) {
    LOGI("nativeSetIsMOGA(%d)", (int)v);
}
extern "C" JNIEXPORT void JNICALL
Java_com_gameloft_android_ANMP_GloftN3HM_GL2JNILib_init(JNIEnv*, jclass) {
    LOGI("init()");
    const char* roots[] = {
        "/sdcard/Android/data/com.gameloft.android.ANMP.GloftN3HM/files",
        "/storage/emulated/0/Android/data/com.gameloft.android.ANMP.GloftN3HM/files",
        g_path0, g_path1, g_path2, g_path3
    };
    const char* names[] = {
        "levels.gla","actors.gla","weapons.gla","sprites.gla",
        "sounds_hi.gla","menus.gla","effects.gla"
    };
    for (auto root : roots) {
        if (!root || !root[0]) continue;
        LOGI("probe root=%s", root);
        for (auto n : names) {
            char buf[768];
            snprintf(buf, sizeof buf, "%s/%s", root, n);
            FILE* f = fopen(buf, "rb");
            if (f) {
                fseek(f, 0, SEEK_END);
                long sz = ftell(f);
                fclose(f);
                LOGI("FOUND %s size=%ld", buf, sz);
            }
        }
    }
}
