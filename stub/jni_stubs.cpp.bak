extern "C" JNIEXPORT jstring JNICALL
Java_com_gameloft_android_ANMP_GloftN3HM_installer_GameInstaller_getPublicKey(JNIEnv* env, jclass) {
    LOGI("getPublicKey()");
    /* chave de teste LVL (AOSP) — só para o parser RSA não rebentar */
    return env->NewStringUTF(
        "MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAy0REY8A0AQAB");
}

