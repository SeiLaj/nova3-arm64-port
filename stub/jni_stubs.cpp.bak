extern "C" JNIEXPORT void JNICALL
Java_com_gameloft_android_ANMP_GloftN3HM_GL2JNILib_setResourcePath(JNIEnv* env, jclass, jstring p) {
    const char* s = p ? env->GetStringUTFChars(p, nullptr) : nullptr;
    LOGI("setResourcePath(%s)", s ? s : "(null)");
    if (s) env->ReleaseStringUTFChars(p, s);
}
